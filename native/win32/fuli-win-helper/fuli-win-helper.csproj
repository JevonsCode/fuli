<Project Sdk="Microsoft.NET.Sdk">

  <!-- fuli-win-helper (rec#7 D-28.10): built only by GitHub Actions on
       windows-latest (.github/actions/win-helper). The package pins the SHA-256
       of that build in src/presence/windows-helper-pin.js and checks it before
       every start. Native AOT: one executable, no .NET runtime needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>fuli-win-helper</AssemblyName>
    <RootNamespace>Fuli.WinHelper</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
