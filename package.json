{
  "name": "fuli-context",
  "version": "0.20.0-beta.15",
  "description": "Local-first collaboration relationship graph for AI agents.",
  "type": "module",
  "files": [
    "README.zh-CN.md",
    "npm-shrinkwrap.json",
    "src/",
    "native/win32/fuli-win-helper.exe",
    "packages/roundtable/package.json",
    "packages/roundtable/bin/",
    "packages/roundtable/src/",
    "dist/web/",
    "docs/external-knowledge-architecture.md",
    "docs/public-personal-architecture.md",
    "docs/project-agent-memory.md",
    "docs/agent-conversations-and-collaboration.md",
    "docs/employee-agents.md",
    "docs/agent-apps.md",
    "docs/agent-interface-architecture.md",
    "docs/agent-roundtable.md",
    "examples/external-knowledge/markdown-folder.mjs",
    "graph-provider/Dockerfile",
    "graph-provider/pyproject.toml",
    "graph-provider/fuli_graph/*.py",
    "graph-provider/fuli_graph/**/*.py",
    "skills/",
    "compose.graphiti.yml",
    "docs/judgment-and-autonomy.md",
    "docs/client-connections.md"
  ],
  "bin": {
    "fl": "src/cli.js",
    "fuli": "src/cli.js"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "context",
    "knowledge-graph",
    "local-first",
    "codex",
    "claude-code"
  ],
  "scripts": {
    "mcp": "node src/mcp-server.js",
    "dev": "run-p dev:server dev:web",
    "dev:server": "node src/server.js",
    "dev:web": "vite",
    "build": "run-s typecheck:web build:web",
    "build:web": "vite build",
    "build:site": "node scripts/build-site.js",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.app.json",
    "test:node": "node --test",
    "test:web": "vitest run --config vitest.config.ts",
    "test:package": "node scripts/package-smoke.js",
    "test:neo4j": "node --test --test-concurrency=1 test/agent-dismissal-acceptance.test.js test/conversation-hook-neo4j-acceptance.test.js test/project-agent-memory-acceptance.test.js test/task-memory-checkpoint-atomicity.test.js",
    "test:knowledge:live": "node acceptance/knowledge-live.js",
    "measure:context-delivery": "node acceptance/context-delivery-replay/run.js",
    "test:external-knowledge:live": "node scripts/validate-external-knowledge-live.js",
    "start": "node src/server.js",
    "graph:setup": "node src/graphiti/setup.js",
    "graph:up": "docker compose -f compose.graphiti.yml up -d --build",
    "graph:down": "docker compose -f compose.graphiti.yml down",
    "test:structure": "node --test test/source-structure.test.js",
    "pretest": "npm run build:web",
    "test": "run-s typecheck:web test:node test:web",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release-gate.js && npm test"
  },
  "engines": {
    "node": ">=24.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JevonsCode/fuli.git"
  },
  "homepage": "https://jevonscode.github.io/fuli/",
  "bugs": {
    "url": "https://github.com/JevonsCode/fuli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@agentclientprotocol/sdk": "1.5.0",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@peculiar/x509": "2.1.0",
    "jsonc-parser": "3.3.1",
    "reflect-metadata": "0.2.2",
    "smol-toml": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/three": "0.169.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "14.4.0",
    "brace-expansion": "5.0.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "^7.9.0",
    "jsdom": "^29.1.1",
    "linkedom": "^0.18.12",
    "npm-run-all2": "^9.0.2",
    "pinia": "^4.0.2",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.169.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.12"
    },
    "brace-expansion": "$brace-expansion",
    "fast-uri": "3.1.9",
    "qs": "6.16.1"
  }
}
