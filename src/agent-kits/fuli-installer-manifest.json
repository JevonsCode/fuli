{
  "schemaVersion": 1,
  "product": "fuli",
  "name": "FULI",
  "version": "{fuliVersion}",
  "mcp": {
    "name": "fuli",
    "command": "{nodePath}",
    "args": ["{mcpServerPath}", "--runtime-config", "{runtimeConfigPath}", "--source-application", "other", "--tool-profile", "chat"],
    "markers": ["--runtime-config"],
    "preserveArgs": ["--tool-profile"]
  },
  "clients": {
    "claude-desktop": {
      "mcp": { "args": ["{mcpServerPath}", "--runtime-config", "{runtimeConfigPath}", "--source-application", "claude", "--tool-profile", "chat"] }
    },
    "gemini-cli": {
      "mcp": { "args": ["{mcpServerPath}", "--runtime-config", "{runtimeConfigPath}", "--source-application", "other", "--tool-profile", "chat"] }
    },
    "kiro": {
      "mcp": {
        "args": ["{mcpServerPath}", "--runtime-config", "{runtimeConfigPath}", "--source-application", "kiro", "--tool-profile", "chat"],
        "extra": { "disabled": false }
      }
    },
    "qwen-code": {
      "mcp": { "args": ["{mcpServerPath}", "--runtime-config", "{runtimeConfigPath}", "--source-application", "other", "--tool-profile", "chat"] }
    },
    "antigravity": {
      "mcp": { "args": ["{mcpServerPath}", "--runtime-config", "{runtimeConfigPath}", "--source-application", "antigravity", "--tool-profile", "chat"] }
    }
  }
}
