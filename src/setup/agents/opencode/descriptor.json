{
  "schemaVersion": 1,
  "id": "opencode",
  "version": "1.0.0",
  "digest": "sha256:46583a34884f0910be60ed13c429eae40db3a04a53afd4e7b44dd3c0cd77ca4e",
  "label": "OpenCode",
  "command": "opencode",
  "detection": {
    "clientHome": {
      "from": "homeDir",
      "path": [
        ".config",
        "opencode"
      ],
      "envBase": "XDG_CONFIG_HOME"
    },
    "files": {
      "configPath": {
        "from": "clientHome",
        "path": [
          "opencode.json"
        ]
      },
      "pluginPath": {
        "from": "clientHome",
        "path": [
          "plugins",
          "fuli",
          "index.js"
        ]
      }
    },
    "skillsRoot": {
      "from": "clientHome",
      "path": [
        "skills"
      ]
    },
    "availableWhen": [
      {
        "probe": "commandOnPath"
      },
      {
        "probe": "pathExists",
        "target": "configPath"
      }
    ]
  },
  "commandSkills": {
    "review": {
      "userCommand": "fuli review",
      "nativeInvocation": "the flreview skill"
    },
    "sessionCommand": false
  },
  "configWriter": "opencode-plugin",
  "mcpServer": {
    "command": "{nodePath}",
    "args": [
      "{mcpServerPath}",
      "--runtime-config",
      "{runtimeConfigPath}",
      "--source-application",
      "opencode",
      "{toolProfileArgs}"
    ]
  },
  "lifecycleHooks": {
    "timeoutSec": 12,
    "events": [
      {
        "event": "prompt"
      },
      {
        "event": "execution.succeeded"
      }
    ]
  }
}
