{
  "schemaVersion": 1,
  "id": "codex",
  "version": "1.0.0",
  "digest": "sha256:c7733ad51c404af94bb6b19b61debcd6277746ffbfd4b598af237ca118182a3c",
  "label": "Codex",
  "command": "codex",
  "detection": {
    "clientHome": {
      "from": "homeDir",
      "path": [
        ".codex"
      ],
      "envOverride": "CODEX_HOME"
    },
    "files": {
      "configPath": {
        "from": "clientHome",
        "path": [
          "config.toml"
        ]
      },
      "hooksPath": {
        "from": "clientHome",
        "path": [
          "hooks.json"
        ]
      },
      "globalInstructionsPath": {
        "from": "clientHome",
        "path": [
          "AGENTS.md"
        ]
      },
      "globalInstructionsOverridePath": {
        "from": "clientHome",
        "path": [
          "AGENTS.override.md"
        ]
      }
    },
    "skillsRoot": {
      "from": "homeDir",
      "path": [
        ".agents",
        "skills"
      ]
    },
    "availableWhen": [
      {
        "probe": "commandOnPath"
      },
      {
        "probe": "pathExists",
        "target": "configPath"
      }
    ]
  },
  "commandSkills": {
    "review": {
      "userCommand": "fuli review",
      "nativeInvocation": "$flreview"
    },
    "sessionCommand": false
  },
  "configWriter": "codex-toml",
  "mcpServer": {
    "command": "{nodePath}",
    "args": [
      "{mcpServerPath}",
      "--runtime-config",
      "{runtimeConfigPath}",
      "--source-application",
      "codex",
      "{toolProfileArgs}"
    ],
    "enabled": true,
    "required": true,
    "startup_timeout_sec": 30,
    "tool_timeout_sec": 120,
    "default_tools_approval_mode": "auto"
  },
  "lifecycleHooks": {
    "timeoutSec": 30,
    "events": [
      {
        "event": "UserPromptSubmit"
      },
      {
        "event": "Stop"
      },
      {
        "event": "SessionStart"
      },
      {
        "event": "PreCompact"
      }
    ]
  },
  "instructions": {
    "global": [
      "At start of every user task, use the FULI hook context if supplied;",
      "do not repeat the fallback. Otherwise before any other tool or answer, call exactly",
      "`get_collaboration_preferences` with `projectPath`=current working directory,",
      "`taskPrompt`=current user request. Never substitute a project action.",
      "Fuli never stores or returns them. Apply all returned `effective_preferences`.",
      "Before reasking a stable project fact or method, inspect `task_knowledge_recall`.",
      "On miss: `search_current_project_knowledge`; focused action/artifact/target/identifier;",
      "never use the full request as the only query.",
      "Write tools: preferences in actual payload; mentioning later is not compliance.",
      "Other FULI work (teams, workers, saved decisions, a relevant `deferred_conflict`)",
      "only when the task needs it: find the tool with `list_agent_interfaces`."
    ]
  }
}
