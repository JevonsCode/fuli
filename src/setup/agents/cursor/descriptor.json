{
  "schemaVersion": 1,
  "id": "cursor",
  "version": "1.0.0",
  "digest": "sha256:779ff6864de5f1519962d34b01df0a9135f909c2929f4e16effd68f081063483",
  "label": "Cursor",
  "command": "cursor",
  "detection": {
    "clientHome": {
      "from": "homeDir",
      "path": [
        ".cursor"
      ]
    },
    "files": {
      "configPath": {
        "from": "clientHome",
        "path": [
          "mcp.json"
        ]
      },
      "hooksPath": {
        "from": "clientHome",
        "path": [
          "hooks.json"
        ]
      }
    },
    "skillsRoot": {
      "from": "clientHome",
      "path": [
        "skills"
      ]
    },
    "availableWhen": [
      {
        "probe": "commandOnPath"
      },
      {
        "probe": "pathExists",
        "target": "configPath"
      },
      {
        "probe": "pathExists",
        "target": "clientHome"
      }
    ]
  },
  "commandSkills": {
    "sessionCommand": true
  },
  "configWriter": "cursor-hooks",
  "mcpServer": {
    "command": "{nodePath}",
    "args": [
      "{mcpServerPath}",
      "--runtime-config",
      "{runtimeConfigPath}",
      "--source-application",
      "cursor",
      "{toolProfileArgs}"
    ]
  },
  "lifecycleHooks": {
    "timeoutSec": 30,
    "events": [
      {
        "event": "sessionStart"
      },
      {
        "event": "beforeSubmitPrompt"
      },
      {
        "event": "stop",
        "loopLimit": 2
      }
    ]
  }
}
