<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundled Node (FULI.app/Contents/Resources/fuli/runtime/node/bin/node) under
  the hardened runtime of a Developer ID build (scripts/sign-macos-app.js).
  - allow-jit: V8 compiles JavaScript to machine code in MAP_JIT memory.
  - allow-unsigned-executable-memory: V8's WebAssembly and code-space pages are
    writable and executable outside MAP_JIT on some paths; Node's own release
    builds carry it for the same reason.
  Not granted: disable-library-validation. FULI loads no native addons
  (scripts/build-macos-app.js installs production dependencies without
  install scripts, and none ships a .node binary); every library Node loads is
  signed with the app.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
